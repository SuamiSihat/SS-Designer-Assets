<Page x:Class="SS_CAM.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Project Timeline">

    <Grid PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <!-- Main Scrollable Content Canvas -->
        <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel Margin="24,14,24,24">
                <!-- Page Header & Summary Bar -->
                <StackPanel Margin="0,0,0,10">
                    <!-- Header Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Visual Project Timeline &amp; Calendar" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Monthly project schedule, visual Gantt timeline charts, and deliverable deadlines." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,12" />

                    <!-- KPI Quick Summary Cards (4 Cards) -->
                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <!-- Deadlines This Month -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="DEADLINES THIS MONTH" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricDeadlinesMonth" Text="0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Scheduled deliverables" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Started This Month -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="STARTED THIS MONTH" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricStartedMonth" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="New projects kicked off" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Overdue / Critical -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="OVERDUE / CRITICAL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricOverdue" Text="0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Past due dates" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Total Active Projects -->
                        <ui:Card Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="TOTAL PROJECTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricTotalProjects" Text="0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Active tracked projects" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </UniformGrid>
                </StackPanel>

                <!-- Interactive Control Bar (Month Navigation & Filters) -->
                <ui:Card Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Month Navigation Buttons & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Click="OnPrevMonthClicked" Appearance="Secondary" Height="32" Padding="10,0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Previous Month">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Prev" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Click="OnTodayClicked" Appearance="Primary" Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Go to Current Month">
                                <ui:TextBlock Text="Today" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                            </ui:Button>

                            <ui:Button Click="OnNextMonthClicked" Appearance="Secondary" Height="32" Padding="10,0" Cursor="Hand" Margin="0,0,16,0" ToolTip="Next Month">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="Next" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:TextBlock x:Name="TxtCurrentMonthTitle" Text="August 2026" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Centered Filters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtSearchQuery" Width="180" Height="36" Padding="10,0" VerticalContentAlignment="Center" PlaceholderText="Filter projects..." Icon="Search24" TextChanged="OnSearchQueryChanged" FontSize="11.5" Margin="0,0,10,0"/>

                            <ui:TextBlock Text="Designer:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DesignerFilter" Width="140" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged" FontSize="11.5" Margin="0,0,10,0"/>

                            <ui:TextBlock Text="Status:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="StatusFilter" Width="130" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged" FontSize="11.5">
                                <ComboBoxItem Content="All Statuses" IsSelected="True" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Actions & View Switcher -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Segmented View Switcher Buttons -->
                            <Border Background="{DynamicResource TextControlBackground}" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnViewGrid" Click="OnViewGridClicked" Appearance="Primary" Width="32" Height="28" Padding="0" Cursor="Hand" ToolTip="Grid View (Monthly Calendar)">
                                        <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="14" VerticalAlignment="Center"/>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnViewGantt" Click="OnViewGanttClicked" Appearance="Secondary" Width="32" Height="28" Padding="0" Cursor="Hand" ToolTip="Gantt Timeline (Visual Project Chart)">
                                        <ui:SymbolIcon Symbol="Timeline24" FontSize="14" VerticalAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <ui:Button Appearance="Secondary" Click="OnRefreshClicked" Width="32" Height="32" Padding="0" Cursor="Hand" ToolTip="Refresh Calendar &amp; Timeline Data">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" VerticalAlignment="Center"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Main Monthly Grid Canvas Container -->
                <StackPanel x:Name="CalendarGridContainer" Margin="0,0,0,14" Visibility="Visible">
                    <!-- Day Name Headers Bar -->
                    <UniformGrid Columns="7" Margin="0,0,0,6">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="4,0,0,4" Margin="0,0,4,0">
                            <ui:TextBlock Text="SUN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="MON" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="TUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="WED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="THU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="FRI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="0,4,4,0">
                            <ui:TextBlock Text="SAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>

                    <!-- Dynamic 7x6 Day Cells Grid Container -->
                    <UniformGrid x:Name="CalendarGrid" Columns="7" VerticalAlignment="Top"/>
                </StackPanel>

                <!-- Visual Project Timeline / Gantt Chart Canvas Container -->
                <ui:Card x:Name="GanttContainer" Margin="0,0,0,14" Padding="14,12" Visibility="Collapsed">
                    <Grid x:Name="GanttGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Gantt Timeline Off-Days & Status Legend Bar -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,6" Background="{DynamicResource TextControlBackground}" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="Timeline Off-Days &amp; Conflict Guide:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Working Days -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Working Day" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Weekend Off-Day -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#1864748B" BorderBrush="#3564748B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Weekend (Sat/Sun Off-Day)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Public Holiday Off-Day -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#28EF4444" BorderBrush="#60EF4444" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="&#x1F1F2;&#x1F1FE; Public Holiday (Off-Day)" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Today Marker -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Today" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <!-- Conflict Alert -->
                                    <ui:TextBlock Text="&#x26A0; Due on Off-Day (Reschedule Required)" FontSize="10" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Timeline Header Row (Days of current month) -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="6" Margin="0,0,0,8">
                            <Grid x:Name="GanttHeaderGrid"/>
                        </Border>

                        <!-- Timeline Rows Stack with Today Guide Line Overlay & Background Grid Fills -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                            <Grid>
                                <Grid x:Name="GanttBackgroundGrid" IsHitTestVisible="False" Panel.ZIndex="0"/>
                                <StackPanel x:Name="GanttRowsStack" Panel.ZIndex="1"/>
                                <Grid x:Name="GanttTodayRowsGrid" IsHitTestVisible="False" Panel.ZIndex="10"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Day Detail Side Overlay Drawer -->
        <Border x:Name="DayDetailPanel"
                Width="380" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="20" LastChildFill="True">
                <!-- Close Button -->
                <ui:Button DockPanel.Dock="Top" Click="OnCloseDayDetail" HorizontalAlignment="Right"
                           Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" ToolTip="Close Panel">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>

                <!-- Selected Date Title -->
                <ui:TextBlock DockPanel.Dock="Top" x:Name="DayDetailTitle"
                              Text="August 12, 2026" FontSize="16" FontWeight="Bold"
                              Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,4"/>
                <ui:TextBlock DockPanel.Dock="Top" x:Name="DayDetailSubtitle"
                              Text="3 projects scheduled for this date" FontSize="12"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                <!-- Day Schedule List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DayDetailItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{Binding PriorityColor}" Visibility="{Binding PriorityBadgeVisibility}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                <ui:TextBlock Text="{Binding PriorityBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="5,2">
                                                <ui:TextBlock Text="{Binding EventType}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:TextBlock Text="{Binding Project}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <ui:TextBlock Text="{Binding DesignerDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Click="OnOpenDrawerFromDayDetailClicked" Tag="{Binding FullPath}" Appearance="Primary" Height="28" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Inspect &amp; Edit Project Timeline">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="Inspect" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button Click="OnOpenProjectFolderClicked" Tag="{Binding FullPath}" Appearance="Secondary" Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip="Open Folder">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="13" VerticalAlignment="Center"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Project Detail & Inspector Side Overlay Drawer -->
        <Border x:Name="ProjectDetailDrawer"
                Width="440" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Panel.ZIndex="100"
                Visibility="Collapsed">
            <DockPanel Margin="20,16,20,16" LastChildFill="True">
                <!-- Header Top Section -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <!-- Top Row: Badges & Close Button -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource FluentBrand80}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                <ui:TextBlock x:Name="DrawerJobId" Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border x:Name="DrawerStatusBadge" Background="{DynamicResource TextControlBackground}" CornerRadius="3" Padding="6,2">
                                <ui:TextBlock x:Name="DrawerStatusBadgeText" Text="BACKLOG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <ui:Button Click="OnCloseProjectDetailDrawer" HorizontalAlignment="Right"
                                   Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close Inspector Drawer">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </Grid>

                    <!-- Title & Subtitle -->
                    <ui:TextBlock x:Name="DrawerTitle" Text="Project Title" FontSize="16" FontWeight="Bold"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <ui:TextBlock x:Name="DrawerSubtitle" Text="Designer &#x2022; Workspace Path" FontSize="11"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                    <!-- Action Toolbar -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnDrawerSave" Appearance="Primary" Click="OnDrawerSaveClicked" Height="30" Padding="14,0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Save all changes to project README.md">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Save Changes" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Click="OnDrawerOpenFolderClicked" Appearance="Secondary" Height="30" Width="30" Padding="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Open Project Folder in File Explorer">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="13" VerticalAlignment="Center"/>
                            </ui:Button>

                            <ui:Button Click="OnDrawerOpenSourceClicked" Appearance="Secondary" Height="30" Width="30" Padding="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Open Working Source File (.afdesign, .psd, .ai)">
                                <ui:SymbolIcon Symbol="DocumentEdit24" FontSize="13" VerticalAlignment="Center"/>
                            </ui:Button>

                            <ui:Button Click="OnDrawerOpenCanvaClicked" Appearance="Secondary" Height="30" Width="30" Padding="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Open Canva Design Template in Browser">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="13" VerticalAlignment="Center"/>
                            </ui:Button>

                            <ui:Button Click="OnDrawerHandoverZipClicked" Appearance="Secondary" Height="30" Width="30" Padding="0" Cursor="Hand" ToolTip="Export Creative Handover Package (ZIP)">
                                <ui:SymbolIcon Symbol="Archive24" FontSize="13" VerticalAlignment="Center"/>
                            </ui:Button>
                        </StackPanel>

                        <ui:TextBlock x:Name="DrawerSaveStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Scrollable Body Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,0,0">
                        <!-- Off-Day Conflict Alert Card -->
                        <Border x:Name="DrawerConflictBanner" Visibility="Collapsed"
                                Background="#1AFE4949" BorderBrush="#DC2626" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Off-Day Schedule Conflict" FontSize="11" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="DrawerConflictText" Text="Project deadline falls on a non-working off-day. Please adjust to a working day."
                                              FontSize="10.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ui:Button Appearance="Secondary" Height="26" Padding="10,0" HorizontalAlignment="Left"
                                           Click="OnDrawerFixConflictClicked" Cursor="Hand" ToolTip="Advance deadline to the next available working day">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CalendarArrowRight24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Reschedule to Next Working Day" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <!-- Card 1: Timeline, Dates & Duration -->
                        <ui:Card Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="CalendarClock24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="TIMELINE &amp; DURATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Date -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Start Date" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <DatePicker x:Name="DrawerStartDate" Height="32" FontSize="11" SelectedDateChanged="OnDrawerDateChanged"/>
                                    </StackPanel>

                                    <!-- Deadline Date -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Deadline (End Date)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <DatePicker x:Name="DrawerDeadline" Height="32" FontSize="11" SelectedDateChanged="OnDrawerDateChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Duration & Quick Stepper -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <ui:TextBlock Text="Duration" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ui:TextBox x:Name="DrawerDuration" Width="80" Height="32" FontSize="11" PlaceholderText="e.g. 3d" TextChanged="OnDrawerDurationChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <ui:TextBlock Text="Quick Extend Deadline" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Appearance="Secondary" Content="+1 Day" Click="OnDrawerAddDaysClicked" Tag="1" Height="32" Padding="8,0" FontSize="10.5" Margin="0,0,4,0" Cursor="Hand"/>
                                            <ui:Button Appearance="Secondary" Content="+3 Days" Click="OnDrawerAddDaysClicked" Tag="3" Height="32" Padding="8,0" FontSize="10.5" Margin="0,0,4,0" Cursor="Hand"/>
                                            <ui:Button Appearance="Secondary" Content="+1 Week" Click="OnDrawerAddDaysClicked" Tag="7" Height="32" Padding="8,0" FontSize="10.5" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Card 2: Ownership, Status & Priority -->
                        <ui:Card Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="OWNERSHIP &amp; METADATA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Project Status" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="DrawerStatus" Height="32" FontSize="11" SelectionChanged="OnDrawerStatusSelectionChanged">
                                            <ComboBoxItem Content="backlog"/>
                                            <ComboBoxItem Content="in-progress"/>
                                            <ComboBoxItem Content="review"/>
                                            <ComboBoxItem Content="revision"/>
                                            <ComboBoxItem Content="approved"/>
                                            <ComboBoxItem Content="done"/>
                                            <ComboBoxItem Content="on-hold"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Priority -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Priority" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="DrawerPriority" Height="32" FontSize="11">
                                            <ComboBoxItem Content="low"/>
                                            <ComboBoxItem Content="medium"/>
                                            <ComboBoxItem Content="high"/>
                                            <ComboBoxItem Content="urgent"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Task Owner / Designer -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Assigned Designer" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="DrawerDesigner" Height="32" FontSize="11" IsEditable="True"/>
                                    </StackPanel>

                                    <!-- Revision Stepper -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Revision Round" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Click="OnDrawerRevisionDecrementClicked" Appearance="Secondary" Height="32" Width="30" Padding="0" Cursor="Hand" ToolTip="Decrease revision">
                                                <ui:SymbolIcon Symbol="Subtract24" FontSize="10" VerticalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:TextBox Grid.Column="1" x:Name="DrawerRevision" Height="32" FontSize="11" HorizontalContentAlignment="Center" Margin="3,0" Text="0"/>
                                            <ui:Button Grid.Column="2" Click="OnDrawerRevisionIncrementClicked" Appearance="Secondary" Height="32" Width="30" Padding="0" Cursor="Hand" ToolTip="Increase revision">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="10" VerticalAlignment="Center"/>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Card 3: Deliverables & Subtasks -->
                        <ui:Card Margin="0,0,0,10" Padding="12">
                            <StackPanel>
                                <!-- Deliverables Header -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="DELIVERABLES &amp; SUBTASKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBlock x:Name="DrawerSubtasksProgress" Text="(0/0 &#x2022; 0 pts)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ui:Button HorizontalAlignment="Right" Appearance="Secondary" Click="OnDrawerAddSubtaskClicked" Height="26" Padding="10,0" FontSize="10.5" Cursor="Hand" ToolTip="Add a new deliverable spec or variation">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Add" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>

                                <!-- Subtasks Progress Bar -->
                                <ProgressBar x:Name="DrawerSubtasksProgressBar" Height="4" Margin="0,0,0,8" Value="0" Maximum="100" Foreground="{DynamicResource FluentBrand80}"/>

                                <!-- Inline Add/Edit Subtask Editor Card -->
                                <Border x:Name="DrawerSubtaskEditorCard" Visibility="Collapsed" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <ui:TextBlock x:Name="DrawerSubtaskEditorTitle" Text="Add Deliverable / Subtask" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>

                                        <!-- Row 1: ID & Name -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Text="ID" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="DrawerSubtaskId" Height="28" FontSize="10.5" PlaceholderText="KV01"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Text="Deliverable Name / Asset Title" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="DrawerSubtaskName" Height="28" FontSize="10.5" PlaceholderText="e.g. Master Key Visual 1:1"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 2: Specs & Type -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Text="Specs (Aspect Ratio, Size)" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="DrawerSubtaskSpecs" IsEditable="True" Height="28" FontSize="10.5">
                                                    <ComboBoxItem Content="1:1, 1080x1080 (Square Post)"/>
                                                    <ComboBoxItem Content="9:16, 1080x1920 (Reels/TikTok/Story)"/>
                                                    <ComboBoxItem Content="16:9, 1920x1080 (YouTube/Landscape)"/>
                                                    <ComboBoxItem Content="4:5, 1080x1350 (IG Portrait Post)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Text="Type" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="DrawerSubtaskType" IsEditable="True" Height="28" FontSize="10.5">
                                                    <ComboBoxItem Content="key_visual"/>
                                                    <ComboBoxItem Content="resize"/>
                                                    <ComboBoxItem Content="hook_variation"/>
                                                    <ComboBoxItem Content="master_video"/>
                                                    <ComboBoxItem Content="artwork"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 3: Weight & Status -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Text="Complexity Points (Weight)" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="DrawerSubtaskWeight" IsEditable="True" Height="28" FontSize="10.5">
                                                    <ComboBoxItem Content="0.2 pt (Format Resize)"/>
                                                    <ComboBoxItem Content="0.4 pt (Hook Variation)"/>
                                                    <ComboBoxItem Content="1.0 pt (Master Key Visual)"/>
                                                    <ComboBoxItem Content="2.0 pts (Master Story Cut 30-60s)"/>
                                                    <ComboBoxItem Content="6.0 pts (Long-Form Episode)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Text="Status" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="DrawerSubtaskStatus" Height="28" FontSize="10.5">
                                                    <ComboBoxItem Content="Draft" Tag="draft"/>
                                                    <ComboBoxItem Content="In Progress" Tag="in-progress"/>
                                                    <ComboBoxItem Content="Done" Tag="done"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Appearance="Secondary" Content="Cancel" Click="OnDrawerCancelSubtaskEditClicked" Height="26" Padding="12,0" FontSize="10.5" Margin="0,0,6,0" Cursor="Hand"/>
                                            <ui:Button Appearance="Primary" Content="Save Deliverable" Click="OnDrawerSaveSubtaskEditClicked" Height="26" Padding="14,0" FontSize="10.5" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Subtasks Items List -->
                                <ItemsControl x:Name="DrawerSubtasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource TextControlBackground}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <ui:TextBlock Text="{Binding Id}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                                            </Border>
                                                            <ui:TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <ui:TextBlock Text="{Binding Type}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <ui:TextBlock Text=" &#x2022; " FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <ui:TextBlock Text="{Binding Specs}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Weight Badge -->
                                                    <Border Grid.Column="1" Background="{DynamicResource TextControlBackground}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="6,0">
                                                        <ui:TextBlock Text="{Binding WeightDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                                    </Border>

                                                    <!-- Status Button Toggle -->
                                                    <ui:Button Grid.Column="2" Appearance="Secondary" Height="24" Padding="8,0" Click="OnDrawerSubtaskStatusToggleClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Click to cycle status: Draft &#x2192; In Progress &#x2192; Done">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StatusBadgeColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <ui:TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- Edit Subtask Button -->
                                                    <ui:Button Grid.Column="3" Appearance="Secondary" Height="24" Width="24" Padding="0" Margin="4,0,0,0" Click="OnDrawerEditSubtaskClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Edit deliverable info">
                                                        <ui:SymbolIcon Symbol="Edit16" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </ui:Button>

                                                    <!-- Delete Subtask Button -->
                                                    <ui:Button Grid.Column="4" Appearance="Secondary" Height="24" Width="24" Padding="0" Margin="4,0,0,0" Click="OnDrawerRemoveSubtaskClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Remove this deliverable">
                                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>

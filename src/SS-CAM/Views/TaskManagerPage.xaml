<Page x:Class="SS_CAM.Views.TaskManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Task Manager">
    <Page.Resources>
        <Style TargetType="CalendarDayButton">
            <Style.Triggers>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FluentBrand80}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="KanbanCardTemplate">
            <ui:CardAction Margin="0,0,0,8" Padding="12,10" Cursor="Hand"
                           Click="OnProjectCardClicked"
                           PreviewMouseLeftButtonDown="OnCardPreviewMouseLeftButtonDown"
                           MouseMove="OnCardMouseMove">
                <ui:CardAction.ContextMenu>
                    <ContextMenu Opened="OnCardContextMenuOpened">
                        <MenuItem Header="Move to Backlog" Tag="backlog" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Move to In Progress" Tag="in-progress" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Move to Review" Tag="review" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Move to Revision" Tag="revision" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Mark as Approved" Tag="approved" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Move to Done" Tag="done" Click="OnQuickStatusMenuClicked"/>
                        <MenuItem Header="Set On Hold" Tag="on-hold" Click="OnQuickStatusMenuClicked"/>
                        <Separator Visibility="{Binding CanvaBadgeVisibility}"/>
                        <MenuItem Header="Open in Canva" Visibility="{Binding CanvaBadgeVisibility}" Click="OnOpenInCanvaClicked"/>
                        <Separator/>
                        <MenuItem Header="Hand Over Task To..." Tag="handover_root">
                            <MenuItem Header="Loading team..." IsEnabled="False"/>
                        </MenuItem>
                    </ContextMenu>
                </ui:CardAction.ContextMenu>
                <StackPanel>
                    <ui:TextBlock Text="{Binding Project}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="#00C4CC" Visibility="{Binding CanvaBadgeVisibility}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                            <ui:TextBlock Text="CANVA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{Binding PriorityColor}" Visibility="{Binding PriorityBadgeVisibility}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                            <ui:TextBlock Text="{Binding PriorityBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="{Binding DeadlineBadgeBackground}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                            <ui:TextBlock Text="{Binding DeadlineDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DeadlineBadgeForeground}" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Creative Units & Subtask Progress Badge -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Target24" FontSize="10" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{Binding SubtaskProgressDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="10" Foreground="{Binding AgeBadgeColor}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{Binding AgeDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AgeBadgeColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Subtask Progress Indicator (Visible when subtasks exist) -->
                    <Grid Visibility="{Binding SubtaskProgressVisibility}" Margin="0,6,0,0">
                        <ProgressBar Value="{Binding SubtaskProgressPercent, Mode=OneWay}" Maximum="100" Height="3" Foreground="{DynamicResource FluentBrand80}" Background="{DynamicResource TextControlBackground}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:TextBlock Text="{Binding Designer}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ui:TextBlock Text=" &#x2022; " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="{Binding CreatedDateDisplay}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DurationVisibility}">
                            <ui:TextBlock Text=" &#x2022; " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="Clock24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding Duration}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:CardAction>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header & Metric Quick Glance -->
        <StackPanel Grid.Row="0" Margin="24,14,24,10">
            <!-- Header Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:TextBlock Text="Creative Task Manager" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:TextBlock Text="Kanban board, deadline tracking, drag-and-drop status workflow, and project queue management." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,12" />

            <!-- Metric Quick Glance Cards (5 KPI Summary Bar) -->
            <UniformGrid Columns="5" Margin="0,0,0,0">
                <!-- Total Projects Card -->
                <ui:Card Padding="12,8" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="TOTAL PROJECTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricTotalProjects" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="22" FontWeight="Bold"/>
                        <ui:TextBlock Text="Workspace total" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- In Progress Card -->
                <ui:Card Padding="12,8" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="IN PROGRESS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricInProgress" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="22" FontWeight="Bold"/>
                        <ui:TextBlock Text="Active WIP tasks" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- In Review Card -->
                <ui:Card Padding="12,8" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="IN REVIEW" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricReview" Text="0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="22" FontWeight="Bold"/>
                        <ui:TextBlock Text="Awaiting feedback" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Urgent & Overdue Card -->
                <ui:Card Padding="12,8" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="URGENT / OVERDUE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricUrgent" Text="0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="22" FontWeight="Bold"/>
                        <ui:TextBlock Text="Requires priority" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Completed Card -->
                <ui:Card Padding="12,8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="COMPLETED" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricDone" Text="0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="22" FontWeight="Bold"/>
                        <ui:TextBlock Text="Finished projects" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>

        <!-- Interactive Control & Search Bar -->
        <ui:Card Grid.Row="1" Padding="12,8" Margin="24,0,24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search & Filters -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Real-time Search Input -->
                        <ui:TextBox x:Name="TxtSearchQuery" Width="200" Height="36" Padding="10,0" VerticalContentAlignment="Center" PlaceholderText="Search project or client..." Icon="Search24" TextChanged="OnTMSearchQueryChanged" FontSize="11.5" Margin="0,0,10,0"/>

                        <ui:TextBlock Text="Designer:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="DesignerFilterTM" Width="140" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnTMFilterChanged" FontSize="11.5" Margin="0,0,10,0"/>

                        <ui:TextBlock Text="Status:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="StatusFilter" Width="130" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnTMFilterChanged" FontSize="11.5" Margin="0,0,10,0">
                            <ComboBoxItem Content="All Statuses" IsSelected="True" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="revision" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="approved" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                        </ComboBox>

                        <ui:TextBlock Text="Priority:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="PriorityFilter" Width="130" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnTMFilterChanged" FontSize="11.5" Margin="0,0,10,0">
                            <ComboBoxItem Content="All Priorities" Tag="all" IsSelected="True" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="P3 (Urgent)" Tag="urgent" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="P2 (High)" Tag="high" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="P1 (Medium)" Tag="medium" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="Low" Tag="low" VerticalContentAlignment="Center"/>
                        </ComboBox>

                        <ui:TextBlock Text="Sort:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SortFilter" Width="165" Height="36" Padding="10,0" VerticalContentAlignment="Center" SelectionChanged="OnTMFilterChanged" FontSize="11.5" Margin="0,0,10,0">
                            <ComboBoxItem Content="Oldest First (Queue)" IsSelected="True" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="Newest First" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="Deadline (Urgent)" VerticalContentAlignment="Center"/>
                            <ComboBoxItem Content="Priority" VerticalContentAlignment="Center"/>
                        </ComboBox>

                        <ui:Button Appearance="Secondary" Click="OnTMResetFiltersClicked" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="Clear Search &amp; Filters">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" VerticalAlignment="Center"/>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions & Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="TxtTaskCount" Text="0 projects" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ui:Button Appearance="Primary" Click="OnTMRefreshClicked" Width="32" Height="32" Padding="0" Cursor="Hand" ToolTip="Scan Workspace Projects">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" VerticalAlignment="Center"/>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Kanban Board Columns (Header Pinned to Top of Each Column Stack, VerticalContentAlignment Top) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch" Margin="24,0,24,14"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">

                <!-- Backlog Column -->
                <ui:Card Width="260" Margin="0,0,14,0" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="backlog"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Backlog" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountBacklog" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListBacklog" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <!-- In Progress Column -->
                <ui:Card Width="260" Margin="0,0,14,0" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="in-progress"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="In Progress" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FluentBrand80}"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountInProgress" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListInProgress" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <!-- Review Column -->
                <ui:Card Width="260" Margin="0,0,14,0" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="review"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Review Queue" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountReview" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListReview" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <!-- Revision Required Column -->
                <ui:Card Width="260" Margin="0,0,14,0" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="revision"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Revision Required" FontWeight="Bold" FontSize="12" Foreground="#D97706"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountRevision" Text="0" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListRevision" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <!-- Done & Approved Column -->
                <ui:Card Width="260" Margin="0,0,14,0" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="done"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Done &amp; Approved" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountDone" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListDone" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>

                <!-- On Hold / Queued Column -->
                <ui:Card Width="260" Padding="0" ClipToBounds="True"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         AllowDrop="True" Tag="on-hold"
                         DragOver="OnColumnDragOver" DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pinned Column Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="On Hold / Queued" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountOther" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable Cards Stack -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="Transparent" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="ListOther" Margin="8" VerticalAlignment="Top" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Project Detail Overlay (Glassmorphic Frosted Drawer with Depth Shadow) -->
        <Border x:Name="DetailPanel" Grid.Row="0" Grid.RowSpan="3"
                Width="920" HorizontalAlignment="Right"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <DockPanel Margin="20" LastChildFill="True">
                <!-- Close Button -->
                <ui:Button DockPanel.Dock="Top" Click="OnDetailClose" HorizontalAlignment="Right"
                           Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8" ToolTip="Close Panel">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>

                <!-- Project Title & Quick Actions Bar (Top) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ui:TextBlock x:Name="DetailProjectName"
                                 FontSize="16" FontWeight="Bold"
                                 Foreground="{DynamicResource FluentBrand80}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- 1-Click Launchers, Handover Bar & Save Button -->
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnDetailOpenFolder" Click="OnDetailOpenFolderClicked" Appearance="Secondary" Height="28" Padding="8,2" Margin="0,0,6,4" ToolTip="Open project folder in Windows Explorer">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,4,0" FontSize="12"/>
                                <ui:TextBlock Text="Folder" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="BtnDetailOpenSource" Click="OnDetailOpenSourceClicked" Appearance="Secondary" Height="28" Padding="8,2" Margin="0,0,6,4" ToolTip="Open working file in Affinity Designer / Photoshop">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color24" Margin="0,0,4,0" FontSize="12"/>
                                <ui:TextBlock Text="Source File" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="BtnDetailOpenCanva" Click="OnDetailOpenCanvaClicked" Appearance="Secondary" Height="28" Padding="8,2" Margin="0,0,6,4" ToolTip="Open project in Canva Cloud">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#00C4CC" CornerRadius="2" Padding="3,0" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="CANVA" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <ui:TextBlock Text="Open Canva" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="BtnDetailHandoverZip" Click="OnDetailHandoverZipClicked" Appearance="Danger" Height="28" Padding="8,2" Margin="0,0,6,4" ToolTip="Generate 1-click Handover ZIP package">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,4,0" FontSize="12"/>
                                <ui:TextBlock Text="Handover ZIP" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Save Button moved up next to Handover ZIP -->
                        <ui:Button x:Name="BtnDetailSaveTop" Click="OnDetailSave" Appearance="Primary" Height="28" Padding="12,2" Margin="0,0,8,4" Cursor="Hand" ToolTip="Save all metadata, subtasks, and notes to README.md">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,5,0" FontSize="12"/>
                                <ui:TextBlock Text="Save Changes" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:TextBlock x:Name="DetailSaveStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="4,0,0,4"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 2-COLUMN WORKSPACE AREA -->
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: README Notes (48%) -->
                        <ColumnDefinition Width="1.1*" MinWidth="380"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Right Column: Subtasks & Form Metadata (52%) -->
                        <ColumnDefinition Width="1*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: README Notes (Full Height with Markdown Preview / Editor) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,12">
                        <DockPanel LastChildFill="True">
                            <!-- README Header & Tools -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="README Notes &amp; Brief" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Grouped Action Buttons on the Right -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnModePreview" Click="OnReadmeModePreviewClicked" Appearance="Primary" Padding="6,4" Height="24" Width="28" ToolTip="Preview Rendered Markdown">
                                                <ui:SymbolIcon Symbol="Eye24" FontSize="11" VerticalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="BtnModeEdit" Click="OnReadmeModeEditClicked" Appearance="Secondary" Padding="6,4" Height="24" Width="28" ToolTip="Edit Markdown Notes">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="11" VerticalAlignment="Center"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Open External Raw File Button -->
                                    <ui:Button Click="OnOpenRawReadmeClicked" Appearance="Secondary" Padding="4" Width="26" Height="24" Cursor="Hand" ToolTip="Open raw README.md in external text editor">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="11" VerticalAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- README Content Area (Fills entire left column height) -->
                            <Grid VerticalAlignment="Stretch">
                                <FlowDocumentScrollViewer x:Name="DetailReadmeRendered"
                                                          FontFamily="{DynamicResource FluentFontFamily}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="Visible" Margin="0"/>
                                <ui:TextBox x:Name="DetailReadmePreview" FontSize="11.5"
                                            FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace"
                                            AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                            Visibility="Collapsed" PlaceholderText="No notes/content below frontmatter in README.md"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- RIGHT COLUMN: Deliverables & Subtasks + Form Metadata + Asset Dropzone -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Deliverables & Subtasks Section (Prominent at Top of Right Column) -->
                            <Border x:Name="DetailSubtasksSection"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Deliverables &amp; Subtasks" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtDetailSubtasksProgress" Text="(0/0 Done &#x2022; 0 pts)" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Content="+ Add Item" Click="OnAddSubtaskClicked" Height="24" Padding="8,0" FontSize="10.5" Cursor="Hand" ToolTip="Add deliverable or cutdown subtask"/>
                                    </Grid>

                                    <ProgressBar x:Name="DetailSubtasksProgressBar" Value="0" Maximum="100" Height="4" Foreground="{DynamicResource FluentBrand80}" Background="{DynamicResource TextControlBackground}" Margin="0,0,0,8"/>

                                    <!-- Subtask Inline Editor Card (for Add & Edit) -->
                                    <Border x:Name="SubtaskEditorCard" Visibility="Collapsed"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource FluentBrand80}"
                                            BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                                    <ui:TextBlock x:Name="TxtSubtaskEditorTitle" Text="Edit Deliverable / Subtask" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Appearance="Secondary" Height="20" Width="20" Padding="0" Click="OnCancelSubtaskEditClicked" Cursor="Hand" ToolTip="Close editor">
                                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="9"/>
                                                </ui:Button>
                                            </Grid>

                                            <!-- Row 1: ID & Filename / Title -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <ui:TextBlock Text="Tag / ID" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="EditSubtaskId" PlaceholderText="e.g. V01" Height="28" FontSize="10.5"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <ui:TextBlock Text="Filename / Deliverable Name" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="EditSubtaskName" PlaceholderText="e.g. Master Story Cut 60s" Height="28" FontSize="10.5"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Size Ratio / Specs & Deliverable Type -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <ui:TextBlock Text="Size Ratio &amp; Resolution" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="EditSubtaskSpecs" IsEditable="True" Height="28" FontSize="10.5">
                                                        <ComboBoxItem Content="9:16, 1080x1920 (Reels / TikTok / Story)"/>
                                                        <ComboBoxItem Content="1:1, 1080x1080 (Square Feed Post)"/>
                                                        <ComboBoxItem Content="16:9, 1920x1080 (Landscape / YouTube / Display)"/>
                                                        <ComboBoxItem Content="4:5, 1080x1350 (Portrait Feed)"/>
                                                        <ComboBoxItem Content="Custom Dimensions"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <ui:TextBlock Text="Deliverable Type" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="EditSubtaskType" IsEditable="True" Height="28" FontSize="10.5">
                                                        <ComboBoxItem Content="master_video"/>
                                                        <ComboBoxItem Content="hook_variation"/>
                                                        <ComboBoxItem Content="cutdown"/>
                                                        <ComboBoxItem Content="key_visual"/>
                                                        <ComboBoxItem Content="resize"/>
                                                        <ComboBoxItem Content="carousel_slide"/>
                                                        <ComboBoxItem Content="artwork"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 3: Points Weight & Status -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <ui:TextBlock Text="Complexity Points (Weight)" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="EditSubtaskWeight" IsEditable="True" Height="28" FontSize="10.5">
                                                        <ComboBoxItem Content="0.2 pt (Format Resize)"/>
                                                        <ComboBoxItem Content="0.4 pt (Hook Variation)"/>
                                                        <ComboBoxItem Content="1.0 pt (Master Key Visual / Slide)"/>
                                                        <ComboBoxItem Content="2.0 pts (Master Story Cut 30-60s)"/>
                                                        <ComboBoxItem Content="6.0 pts (Long-Form Episode)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <ui:TextBlock Text="Status (Default is Draft)" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="EditSubtaskStatus" Height="28" FontSize="10.5">
                                                        <ComboBoxItem Content="Draft" Tag="draft"/>
                                                        <ComboBoxItem Content="In Progress" Tag="in-progress"/>
                                                        <ComboBoxItem Content="Done" Tag="done"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Save / Cancel Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Appearance="Secondary" Content="Cancel" Click="OnCancelSubtaskEditClicked" Height="26" Padding="12,0" FontSize="10.5" Margin="0,0,6,0" Cursor="Hand"/>
                                                <ui:Button Appearance="Primary" Content="Save Deliverable" Click="OnSaveSubtaskEditClicked" Height="26" Padding="14,0" FontSize="10.5" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Subtasks Items List -->
                                    <ItemsControl x:Name="ListDetailSubtasks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Background="{DynamicResource TextControlBackground}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                    <ui:TextBlock Text="{Binding Id}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                                                </Border>
                                                                <ui:TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <ui:TextBlock Text="{Binding Type}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <ui:TextBlock Text=" &#x2022; " FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <ui:TextBlock Text="{Binding Specs}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Weight Badge -->
                                                        <Border Grid.Column="1" Background="{DynamicResource TextControlBackground}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Margin="6,0">
                                                            <ui:TextBlock Text="{Binding WeightDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                                        </Border>

                                                        <!-- Status Button Toggle -->
                                                        <ui:Button Grid.Column="2" Appearance="Secondary" Height="24" Padding="8,0" Click="OnSubtaskStatusToggleClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Click to cycle status: Draft &#x2192; In Progress &#x2192; Done">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StatusBadgeColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <ui:TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ui:Button>

                                                        <!-- Edit Subtask Button -->
                                                        <ui:Button Grid.Column="3" Appearance="Secondary" Height="24" Width="24" Padding="0" Margin="4,0,0,0" Click="OnEditSubtaskClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Edit deliverable info, filename &amp; size ratio">
                                                            <ui:SymbolIcon Symbol="Edit16" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </ui:Button>

                                                        <!-- Delete Subtask Button -->
                                                        <ui:Button Grid.Column="4" Appearance="Secondary" Height="24" Width="24" Padding="0" Margin="4,0,0,0" Click="OnRemoveSubtaskClicked" Tag="{Binding Id}" Cursor="Hand" ToolTip="Remove this deliverable">
                                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Asset Drag & Drop Ingestion Zone -->
                            <ui:Card x:Name="CardAssetDropzone" AllowDrop="True" Padding="10,8" Margin="0,0,0,12"
                                     DragOver="OnAssetDropzoneOver" DragLeave="OnAssetDropzoneLeave" Drop="OnAssetDropzoneDrop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="Drag &amp; Drop Assets Here" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBlock x:Name="TxtAssetDropHint" Text="Auto-ingests into 01_BRIEF or 05_DELIVERABLES" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Compact 3x2 Form Metadata Grid -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Status -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <ui:TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DetailStatus" Height="34" FontSize="11.5" Padding="8,4" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="revision" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="approved" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Priority -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <ui:TextBlock Text="Priority" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DetailPriority" Height="34" FontSize="11.5" Padding="8,4" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="low" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="medium" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="high" VerticalContentAlignment="Center"/>
                                        <ComboBoxItem Content="urgent" VerticalContentAlignment="Center"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Deadline -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <ui:TextBlock Text="Deadline (YYYY-MM-DD)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="DetailDeadline" Height="34" FontSize="11.5" Padding="4" VerticalContentAlignment="Center" SelectedDateChanged="OnDateChanged"/>
                                </StackPanel>

                                <!-- Created Date -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <ui:TextBlock Text="Created Date (YYYY-MM-DD)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="DetailCreatedDate" Height="34" FontSize="11.5" Padding="4" VerticalContentAlignment="Center" SelectedDateChanged="OnDateChanged"/>
                                </StackPanel>

                                <!-- Task Duration -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <ui:TextBlock Text="Duration (e.g. 3d, 5h)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="DetailDuration" Height="34" FontSize="11.5" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="e.g. 3d"/>
                                </StackPanel>

                                <!-- Revision with Stepper Controls (+ / -) -->
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <ui:TextBlock Text="Revision Round" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Click="OnRevisionDecrementClicked" Appearance="Secondary" Height="34" Width="34" Padding="0" Cursor="Hand" ToolTip="Decrease revision count">
                                            <ui:SymbolIcon Symbol="Subtract24" FontSize="11" VerticalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:TextBox Grid.Column="1" x:Name="DetailRevision" Height="34" FontSize="11.5" Padding="4,4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0" Text="0"/>
                                        <ui:Button Grid.Column="2" Click="OnRevisionIncrementClicked" Appearance="Secondary" Height="34" Width="34" Padding="0" Cursor="Hand" ToolTip="Increase revision count">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="11" VerticalAlignment="Center"/>
                                        </ui:Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Task Owner / Designer -->
                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <ui:TextBlock Text="Task Owner / Designer" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DetailDesigner" Height="34" FontSize="11.5" Padding="8,4" VerticalContentAlignment="Center" IsEditable="True"/>
                                </StackPanel>

                                <!-- Handover Action Button -->
                                <StackPanel Grid.Row="6" Grid.Column="2" VerticalAlignment="Bottom">
                                    <ui:Button x:Name="BtnDetailHandover" Appearance="Secondary" Height="34" HorizontalAlignment="Stretch" Click="OnDetailHandoverClicked" ToolTip="Hand over this task to the selected designer and save immediately">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Hand Over Task" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Page>

<ui:FluentWindow x:Class="SS_CAM.Dialogs.VisualDiffDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Visual Asset Revision Diff Inspector"
                  Height="780" Width="1160"
                  MinWidth="920" MinHeight="640"
                  WindowStartupLocation="CenterScreen"
                  Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Asset Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Interactive Comparison Viewport Canvas -->
            <RowDefinition Height="*"/>
            <!-- 2: Bottom Inspection & Slider Controls -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER & CONTROLS TOOLBAR -->
        <ui:Card Grid.Row="0" Padding="16,10" Margin="16,12,16,8">
            <StackPanel>
                <!-- Row 1: Title & Mode Switcher -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource FluentBrand80}" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="SlideSize24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="Visual Asset Revision Diff" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border Background="{DynamicResource FluentBrandTint}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <ui:TextBlock Text="LIVE INSPECTOR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                </Border>
                            </StackPanel>
                            <ui:TextBlock Text="Inspect creative revisions with interactive split swipe, side-by-side zoom &amp; pan, opacity blend, and pixel difference mapping."
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Inspection Mode Switcher Ribbon -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnModeSplitVertical" Appearance="Primary" Click="OnModeSplitVerticalClicked"
                                   Height="30" Padding="10,0" Cursor="Hand" ToolTip="Vertical Split Swipe Comparison">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SlideSize24" FontSize="12" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Vertical Split" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnModeSplitHorizontal" Appearance="Secondary" Click="OnModeSplitHorizontalClicked"
                                   Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Horizontal Split Swipe Comparison">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SplitVertical24" FontSize="12" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Horizontal Split" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnModeSideBySide" Appearance="Secondary" Click="OnModeSideBySideClicked"
                                   Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Side-by-Side Dual View with Locked Pan &amp; Zoom">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ColumnTriple24" FontSize="12" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Side by Side" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnModeBlend" Appearance="Secondary" Click="OnModeBlendClicked"
                                   Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Opacity Onion Skin Blend (0% - 100%)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DarkTheme24" FontSize="12" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Opacity Blend" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnModeDiff" Appearance="Secondary" Click="OnModeDiffClicked"
                                   Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Pixel Difference Highlighting (Reveals text shifts &amp; color changes)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="12" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Pixel Diff" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Asset Selectors & Zoom Bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Before Selection -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Swap Button -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- After Selection -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Zoom Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Before Label & Dropdown -->
                    <ui:TextBlock Grid.Column="0" Text="Before (Base):" FontSize="11" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBeforeAsset" Grid.Column="1" Height="30" Padding="8,2" FontSize="11"
                              SelectionChanged="OnBeforeAssetChanged" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                    <ui:Button Grid.Column="2" Appearance="Secondary" Click="OnBrowseBeforeClicked" Height="30" Padding="8,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Browse custom before image">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"/>
                    </ui:Button>

                    <!-- Swap Button -->
                    <ui:Button x:Name="BtnSwap" Grid.Column="3" Appearance="Secondary" Click="OnSwapClicked"
                               Height="30" Width="36" Padding="0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Swap Before and After assets">
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="13"/>
                    </ui:Button>

                    <!-- After Label & Dropdown -->
                    <ui:TextBlock Grid.Column="4" Text="After (Revision):" FontSize="11" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbAfterAsset" Grid.Column="5" Height="30" Padding="8,2" FontSize="11"
                              SelectionChanged="OnAfterAssetChanged" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                    <ui:Button Grid.Column="6" Appearance="Secondary" Click="OnBrowseAfterClicked" Height="30" Padding="8,0" Margin="0,0,12,0" Cursor="Hand" ToolTip="Browse custom after image">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"/>
                    </ui:Button>

                    <!-- Zoom Controls -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Click="OnZoomOutClicked" Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip="Zoom Out">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="10"/>
                        </ui:Button>
                        <ui:TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" FontWeight="SemiBold" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                        <ui:Button Appearance="Secondary" Click="OnZoomInClicked" Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip="Zoom In">
                            <ui:SymbolIcon Symbol="Add24" FontSize="10"/>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Click="OnZoomFitClicked" Height="28" Padding="8,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Fit to Viewport">
                            <ui:TextBlock Text="Fit" FontSize="10.5"/>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" Click="OnZoom100Clicked" Height="28" Padding="8,0" Margin="4,0,0,0" Cursor="Hand" ToolTip="Actual Size (1:1)">
                            <ui:TextBlock Text="1:1" FontSize="10.5"/>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- 1. COMPARISON CANVAS VIEWPORT -->
        <Border Grid.Row="1" Margin="16,0,16,8" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="ViewportOuterGrid"
                  Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                  PreviewMouseWheel="OnViewportMouseWheel"
                  MouseDown="OnViewportMouseDown"
                  MouseMove="OnViewportMouseMove"
                  MouseUp="OnViewportMouseUp"
                  ClipToBounds="True">

                <!-- 1A. Single Viewport Mode (Split / Blend / Pixel Diff) -->
                <Grid x:Name="SingleViewportContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Base Image (Before) -->
                    <Image x:Name="ImgBefore" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Revision Image (After) - Clipped in Split Mode or Blended in Blend Mode -->
                    <Image x:Name="ImgAfter" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry x:Name="ImgAfterClip"/>
                        </Image.Clip>
                    </Image>

                    <!-- Pixel Difference Image (Pixel Diff Mode) -->
                    <Image x:Name="ImgDiff" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- Interactive Splitter Overlay Canvas -->
                    <Canvas x:Name="SplitterOverlayCanvas" IsHitTestVisible="False">
                        <!-- Vertical Divider Line & Handle -->
                        <Line x:Name="SplitterLineVertical" Stroke="{DynamicResource FluentBrand80}" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Border x:Name="SplitterHandleVertical" Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource FluentBrand80}" BorderBrush="White" BorderThickness="2"
                                IsHitTestVisible="False">
                            <ui:TextBlock Text="&#xE784;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Horizontal Divider Line & Handle -->
                        <Line x:Name="SplitterLineHorizontal" Stroke="{DynamicResource FluentBrand80}" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="SplitterHandleHorizontal" Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource FluentBrand80}" BorderBrush="White" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <ui:TextBlock Text="&#xE784;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ui:TextBlock.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </ui:TextBlock.RenderTransform>
                            </ui:TextBlock>
                        </Border>
                    </Canvas>

                    <!-- Corner Badges -->
                    <Border x:Name="BadgeBeforeLabel" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#D00F172A" CornerRadius="4" Padding="8,4" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource FluentBrand80}" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtBadgeBefore" Text="BEFORE (Base)" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BadgeAfterLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#D00F172A" CornerRadius="4" Padding="8,4" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtBadgeAfter" Text="AFTER (Revision)" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 1B. Side-by-Side Dual Viewport Mode -->
                <Grid x:Name="SideBySideContainer" Visibility="Collapsed" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Before Pane -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideBeforeScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="SideBeforeTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="ImgSideBefore" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D00F172A" CornerRadius="4" Padding="8,4" Margin="10">
                                <ui:TextBlock x:Name="TxtSideBeforeTitle" Text="BEFORE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Center Divider -->
                    <Border Grid.Column="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Right: After Pane -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideAfterScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="SideAfterTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="ImgSideAfter" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D00F172A" CornerRadius="4" Padding="8,4" Margin="10">
                                <ui:TextBlock x:Name="TxtSideAfterTitle" Text="AFTER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- 2. BOTTOM INSPECTOR & INTERACTIVE SLIDER -->
        <ui:Card Grid.Row="2" Padding="16,10" Margin="16,0,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Metadata Summary -->
                    <ColumnDefinition Width="*"/>
                    <!-- Interactive Swipe / Blend Slider -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Short Guidance Hints -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Asset Technical Metadata -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock x:Name="TxtMetaBefore" Text="Before: -" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetaAfter" Text="After: -" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="BadgeDimensionMatch" Background="{DynamicResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock x:Name="TxtDimensionMatch" Text="1:1 MATCH" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Center: Slider Control -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="TxtSliderLabel" Text="Split Position:" FontSize="11" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="DiffSlider" Minimum="0" Maximum="100" Value="50" Width="240"
                            ValueChanged="OnSliderValueChanged" VerticalAlignment="Center"/>
                    <ui:TextBlock x:Name="TxtSliderPercent" Text="50%" FontSize="11.5" FontWeight="Bold"
                                  Foreground="{DynamicResource FluentBrand80}" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right: Shortcuts & Close Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:TextBlock Text="[Drag/Click] Swipe &#x2022; [Wheel] Zoom &#x2022; [Right-Drag] Pan"
                                  FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ui:Button Appearance="Primary" Click="OnCloseClicked" Height="30" Padding="14,0" Cursor="Hand">
                        Close
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
